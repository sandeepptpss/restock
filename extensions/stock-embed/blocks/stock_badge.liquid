{% comment %}
  Smart Stock Control Theme App Embed Block

  This block has no settings of its own on purpose. Every rule it applies is
  configured in the stockshield app dashboard and delivered through the app-owned
  shop metafield below, so the merchant has one place to change things and the
  dashboard can always report the storefront's real state. Theme-editor settings
  are per-theme: duplicating or switching a theme silently reset them, which made
  the dashboard's "active" badge a lie.

  Turning this embed off in the theme editor remains the merchant's kill switch.
{% endcomment %}

{%- liquid
  # `app.metafields` is the documented path for an app reading its own metafields
  # from its own theme app extension. The bracketed shop lookup is a fallback for
  # contexts where the app object does not resolve the reserved namespace.
  assign ss_config = app.metafields.stockshield.storefront_config.value
  unless ss_config
    assign ss_config = shop.metafields['$app:stockshield']['storefront_config'].value
  endunless

  # Defaults match the app's own defaults, so a shop whose config has not been
  # written yet behaves exactly as it did before the settings moved.
  assign ss_hide_cards = true
  assign ss_low_stock_badge = true
  assign ss_low_stock_text = '🔥 Only a few items left in stock!'
  assign ss_low_stock_limit = 5
  assign ss_out_of_stock_tag = 'out-of-stock'
  assign ss_low_stock_tag = 'low-stock'

  if ss_config
    if ss_config.hideSoldOutCards == false
      assign ss_hide_cards = false
    endif
    if ss_config.lowStockBadge == false
      assign ss_low_stock_badge = false
    endif
    if ss_config.lowStockText != blank
      assign ss_low_stock_text = ss_config.lowStockText
    endif
    if ss_config.lowStockLimit != blank
      assign ss_low_stock_limit = ss_config.lowStockLimit
    endif
    if ss_config.outOfStockTag != blank
      assign ss_out_of_stock_tag = ss_config.outOfStockTag
    endif
    if ss_config.lowStockTag != blank
      assign ss_low_stock_tag = ss_config.lowStockTag
    endif
  endif
-%}

<script>
  window.StockControlEmbed = {
    hideSoldOutCards: {{ ss_hide_cards | json }},
    lowStockBadge: {{ ss_low_stock_badge | json }},
    lowStockText: {{ ss_low_stock_text | json }},
    lowStockLimit: {{ ss_low_stock_limit | json }},
    outOfStockTag: {{ ss_out_of_stock_tag | json }},
    lowStockTag: {{ ss_low_stock_tag | json }},
    {% if product %}
      productId: {{ product.id | json }},
      variants: {{ product.variants | json }},
    {% endif %}
  };
</script>

{% if product %}
  <style>
    .stock-badge-container {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      margin: 8px 0;
    }
    .stock-badge-low {
      background-color: #fef3c7;
      color: #92400e;
      border: 1px solid #fcd34d;
    }
    .stock-badge-out {
      background-color: #fee2e2;
      color: #991b1b;
      border: 1px solid #fca5a5;
    }
  </style>
{% endif %}

<script>
  (function() {
    if (!window.StockControlEmbed || window.StockControlEmbed.hideSoldOutCards !== true) return;

    function autoHideSoldOutCollectionCards() {
      // Do not hide main product display on single product pages
      var path = window.location.pathname || '';
      if (path.indexOf('/products/') === 0 && path.indexOf('/collections/') === -1) {
        return;
      }

      var cardSelectors = [
        '.grid__item',
        '.product-grid-item',
        '.card-wrapper',
        '.product-card',
        '.product-item',
        '.grid-item',
        '.card',
        'li.grid__item',
        '[data-product-id]'
      ];

      cardSelectors.forEach(function(selector) {
        var cards = document.querySelectorAll(selector);
        cards.forEach(function(card) {
          if (card.getAttribute('data-stockshield-checked') === 'true') return;

          // Check if card contains a Sold out indicator badge or tag
          var badge = card.querySelector('.badge, .badge--bottom-left, .price--sold-out, .sold-out, .badge--sold-out, .card__badge, .price__badge-sold-out, .badge--out-of-stock, [data-sold-out]');
          var text = badge ? badge.textContent : card.textContent;

          if (badge && /sold\s*out|out\s*of\s*stock/i.test(badge.textContent)) {
            card.style.setProperty('display', 'none', 'important');
            card.setAttribute('data-stockshield-checked', 'true');
          } else if (
            card.querySelector('.price--sold-out') ||
            card.querySelector('.badge--sold-out') ||
            card.querySelector('.badge--out-of-stock') ||
            /sold\s*out/i.test(text) && (card.querySelector('.badge') || card.querySelector('.price'))
          ) {
            card.style.setProperty('display', 'none', 'important');
            card.setAttribute('data-stockshield-checked', 'true');
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', autoHideSoldOutCollectionCards);
    } else {
      autoHideSoldOutCollectionCards();
    }

    try {
      var observer = new MutationObserver(function() {
        autoHideSoldOutCollectionCards();
      });
      observer.observe(document.body, { childList: true, subtree: true });
    } catch(e) {}
  })();
</script>

{% schema %}
{
  "name": "Stock Control Embed",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "Nothing to configure here. Turning this embed on is the only step — every rule (auto-hide, visibility mode, tags, restock timers, low-stock badge) is managed in the stockshield app dashboard. Use the toggle above to switch the app off for this theme."
    }
  ]
}
{% endschema %}
