# MongoDB connection (Mongoose). Atlas SRV string or a local mongodb:// URL.
# URL-encode the password if it contains reserved characters (@ : / ? # & %).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name. Can also be put in the URI path instead of set here.
MONGODB_DB="stock-shield"

# Shared secret for the scheduled-restock cron endpoint (POST /cron/scheduled-restocks)
CRON_SECRET="change-me"
