{% comment %}
  Smart Stock Control Theme App Embed Block
  Injects real-time stock badges and auto-hides sold-out products from collection grids
{% endcomment %}
{% if product %}
  <script>
    window.StockControlEmbed = {
      productId: {{ product.id | json }},
      variants: {{ product.variants | json }},
      outOfStockTag: "out-of-stock",
      lowStockTag: "low-stock"
    };
  </script>
  <style>
    .stock-badge-container {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      margin: 8px 0;
    }
    .stock-badge-low {
      background-color: #fef3c7;
      color: #92400e;
      border: 1px solid #fcd34d;
    }
    .stock-badge-out {
      background-color: #fee2e2;
      color: #991b1b;
      border: 1px solid #fca5a5;
    }
  </style>
{% endif %}

<script>
  (function() {
    {% if block.settings.hide_sold_out_collections == true or block.settings.hide_sold_out_collections == nil %}
    function autoHideSoldOutCollectionCards() {
      // Do not hide main product display on single product pages
      var path = window.location.pathname || '';
      if (path.indexOf('/products/') === 0 && path.indexOf('/collections/') === -1) {
        return;
      }

      var cardSelectors = [
        '.grid__item',
        '.product-grid-item',
        '.card-wrapper',
        '.product-card',
        '.product-item',
        '.grid-item',
        '.card',
        'li.grid__item',
        '[data-product-id]'
      ];

      cardSelectors.forEach(function(selector) {
        var cards = document.querySelectorAll(selector);
        cards.forEach(function(card) {
          if (card.getAttribute('data-stockshield-checked') === 'true') return;

          // Check if card contains a Sold out indicator badge or tag
          var badge = card.querySelector('.badge, .badge--bottom-left, .price--sold-out, .sold-out, .badge--sold-out, .card__badge, .price__badge-sold-out, .badge--out-of-stock, [data-sold-out]');
          var text = badge ? badge.textContent : card.textContent;

          if (badge && /sold\s*out|out\s*of\s*stock/i.test(badge.textContent)) {
            card.style.setProperty('display', 'none', 'important');
            card.setAttribute('data-stockshield-checked', 'true');
          } else if (
            card.querySelector('.price--sold-out') ||
            card.querySelector('.badge--sold-out') ||
            card.querySelector('.badge--out-of-stock') ||
            /sold\s*out/i.test(text) && (card.querySelector('.badge') || card.querySelector('.price'))
          ) {
            card.style.setProperty('display', 'none', 'important');
            card.setAttribute('data-stockshield-checked', 'true');
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', autoHideSoldOutCollectionCards);
    } else {
      autoHideSoldOutCollectionCards();
    }

    try {
      var observer = new MutationObserver(function() {
        autoHideSoldOutCollectionCards();
      });
      observer.observe(document.body, { childList: true, subtree: true });
    } catch(e) {}
    {% endif %}
  })();
</script>

{% schema %}
{
  "name": "Stock Control Embed",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_low_stock_badge",
      "label": "Show Low Stock Warning Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "low_stock_text",
      "label": "Low Stock Badge Text",
      "default": "🔥 Only a few items left in stock!"
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out_collections",
      "label": "Auto-Hide Sold Out Items from Collection & Search Grids",
      "default": true
    }
  ]
}
{% endschema %}
