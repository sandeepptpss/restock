# MongoDB connection (Mongoose). Atlas SRV string or a local mongodb:// URL.
# URL-encode the password if it contains reserved characters (@ : / ? # & %).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database name. Can also be put in the URI path instead of set here.
MONGODB_DB="stock-shield"

# Shared secret for the scheduled-restock cron endpoint (POST /cron/scheduled-restocks)
CRON_SECRET="change-me"

# Resend Transactional Email API Configuration
RESEND_API_KEY="re_123456789..."
RESEND_FROM_EMAIL="StockShield Alert <onboarding@resend.dev>"

# How long (ms) a scan-triggered alert suppresses the next identical one for the
# same variant. The catalogue scan re-observes a standing stockout on every run,
# so this is measured in hours; the real-time webhook uses a 60s window instead.
# Optional — defaults to 6 hours.
SCAN_ALERT_DEDUPE_MS="21600000"

# Which store(s) staff the support desk, comma separated. A shop listed here sees
# every store's support tickets in Settings > Support & Help Desk and is the only
# one allowed to answer them; every other shop sees just its own tickets, read
# only. Unset means nobody can answer tickets — the allowlist deliberately fails
# closed rather than handing the reply controls back to every merchant.
SUPPORT_ADMIN_SHOPS="your-store.myshopify.com"

# --- SMS restock notifications (Enterprise tier) -----------------------------
# Per-shop credentials are entered in Settings > SMS & Klaviyo and stored against
# the shop; these are only a fallback for a single-tenant deployment, and the
# dashboard values win wherever both are present.

# Which provider to fall back to when a shop has not chosen one: TWILIO or KLAVIYO.
SMS_PROVIDER="TWILIO"

# Twilio — the app sends the message itself.
# TWILIO_FROM_NUMBER takes a purchased number (+14155550123), an alphanumeric
# sender id, or a Messaging Service SID (MG…), which is sent as MessagingServiceSid.
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+14155550123"

# Klaviyo — the app pushes a Back-in-Stock event and the merchant's Klaviyo flow
# sends the SMS. Klaviyo has no send-now API, so a flow triggered by the metric
# below has to exist or nothing is delivered. The private key needs profile and
# event write scopes. KLAVIYO_SMS_LIST_ID is optional: given one, SMS marketing
# consent is recorded against that list before the event is sent.
KLAVIYO_API_KEY="pk_..."
KLAVIYO_SMS_LIST_ID=""

# Klaviyo pins its API to a dated revision. Override only to move ahead of the
# version this app is written against.
# KLAVIYO_API_REVISION="2026-07-15"

# Dialling code assumed for numbers a customer types without one ("555 010 9999").
SMS_DEFAULT_COUNTRY_CODE="+1"
